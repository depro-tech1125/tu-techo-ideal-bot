# ==============================================================================
# TU TECHO IDEAL V5.0 - ARCHIVO DE CONFIGURACIÓN DE VARIABLES DE ENTORNO
# ==============================================================================
# Copie este archivo como .env y complete con las credenciales de su entorno.
# NUNCA suba el archivo .env con credenciales reales a repositorios públicos.

# Puerto del servidor HTTP local / Render
PORT=3000

# Subdominio de Kommo CRM (ejemplo: https://tutechoidealrd.kommo.com)
KOMMO_SUBDOMAIN=tutechoidealrd

# Token de acceso de larga duración de la integración de Kommo CRM (Bearer)
KOMMO_TOKEN=Bearer eyJ0eXAiOiJKV1QiLCJhbGciOiJSUzI1NiIsImtpZCI6...

# ID del Bot/Salesbot oficial en Kommo CRM para despachos a WhatsApp
KOMMO_BOT_ID=100766

# ID del campo personalizado en Kommo donde se escribe la respuesta (Respuesta_IA)
KOMMO_FIELD_ID=2103996

# ID de la cuenta autorizada de Kommo CRM (Blindaje de seguridad anti-spoofing)
KOMMO_ACCOUNT_ID=36728143

# URL pública de exportación CSV o XLSX de Google Sheets (Fuente Única de Verdad)
GOOGLE_SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/1f-s-uK62bU8n_e_rWl5Jb7Dq3r1T4b_f/export?format=csv

# Proveedor de Inteligencia Artificial: OpenRouter (NVIDIA Nemotron Free - $0.00 Costo)
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Modelo de inferencia gratuito configurado por defecto
CLAUDE_MODEL=nvidia/nemotron-3.5-lightning:free
USE_CLAUDE=false

# Datos de contacto de Robert Jiménez para Alertas de Cierre Inmediato (Fase 1 Deliverable D)
ROBERT_WHATSAPP=+584143115105
ROBERT_KOMMO_LEAD_ID=7882504

# Modo de operación:
# false = Modo Producción Activo (Despacha respuestas y alertas reales)
# true  = Modo Observación / Staging (Audita y registra sin despachar a clientes)
OBSERVATION_MODE=false

# Token de autenticación para endpoints administrativos y pruebas de Staging
STAGING_AUTH_TOKEN=tu_token_secreto_para_staging_aqui
